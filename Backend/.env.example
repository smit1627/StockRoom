SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
PORT=3000
FRONTEND_URL=http://localhost:5173
# Optional comma-separated origins for a deployed frontend. Local private-network
# Vite origins are accepted automatically while NODE_ENV is not production.
CORS_ORIGINS=
# Required only when registering an administrator through the web form.
ADMIN_REGISTRATION_CODE=
# Reduces repeat Supabase Auth checks for the same active token. Set 0 to disable.
AUTH_CACHE_TTL_SECONDS=1
